# Copia este archivo: copy .env.example .env
# Nunca subas el .env (tiene claves reales).

# Neon o Postgres. Ejemplo: postgresql+psycopg2://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB"

JWT_SECRET=
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

BASE_URL="http://localhost:8000"
PORT=8000

# Opcional. Groq Free es el que usa Analizar con IA: https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=

EXPO_PUBLIC_API_URL=http://localhost:8000
# EXPO_PUBLIC_WEB_URL=https://tu-dominio-petmatch.cl
