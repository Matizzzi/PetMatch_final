# Copiá este archivo a ".env" (iniciar.bat / iniciar.sh lo hacen solos).
# NUNCA subas el archivo .env a GitHub.

# --- Base de datos (por defecto: Postgres del docker compose) ---
# Desde el contenedor del backend el host se llama "postgres".
DATABASE_URL=postgresql://petmatch_user:petmatch_password@postgres:5432/petmatch

# Si preferís Neon en la nube, reemplazá la línea de arriba por la connection string
# del dashboard (sslmode=require). El contenedor postgres igual arranca, pero no se usa.

BASE_URL=http://localhost:8000
PORT=8000

# --- IA (opcional) ---
# Sin estas claves la app funciona igual: el análisis de fotos usa Pillow en local.
# Groq Free: https://console.groq.com/keys
GROQ_API_KEY=
GEMINI_API_KEY=

EXPO_PUBLIC_API_URL=http://localhost:8000
# EXPO_PUBLIC_WEB_URL=http://localhost:3000
