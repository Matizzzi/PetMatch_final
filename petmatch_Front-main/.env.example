# URL de la API del Backend (FastAPI)
# Local con Docker o Expo: http://localhost:8000
# Producción en Render: https://petmatch-backend-japt.onrender.com
EXPO_PUBLIC_API_URL=http://localhost:8000

# URL pública del frontend web, usada por el código QR de los afiches (/alerta/<id>).
# Opcional en web (se usa el dominio actual). En apps móviles, si falta, el QR usa el deep link petmatchmobile://
# EXPO_PUBLIC_WEB_URL=https://tu-dominio-petmatch.cl
