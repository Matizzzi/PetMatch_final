{
  "expo": {
    "name": "PetMatch",
    "slug": "petmatch-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "petmatchmobile",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "config": {
        "googleMapsApiKey": "AIzaSyAAfgcgxs3m1ABWib_RQzirMJIBxnhFFC0"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8EDD2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAAfgcgxs3m1ABWib_RQzirMJIBxnhFFC0"
        }
      },
      "package": "com.matizzzi.petmatchmobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8EDD2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "PetMatch necesita acceso a tus fotos para guardar los afiches de búsqueda.",
          "savePhotosPermission": "PetMatch guarda en tu galería los afiches de búsqueda que generas.",
          "granularPermissions": ["photo"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7345a6c1-ce57-474e-b91a-55b8ba967062"
      }
    }
  }
}
